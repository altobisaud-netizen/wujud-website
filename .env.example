# Enable the anonymous website-to-customer-app handoff.
VITE_SARA_HANDOFF_ENABLED=false

# Public browser endpoints only; do not put secrets in VITE_ variables.
VITE_SARA_API_BASE_URL=https://api.example.com
VITE_CUSTOMER_APP_URL=https://app.example.com

# Independent WUJUD Wellness operational staging (presentation flags only).
# Backend feature flags remain authoritative. Defaults false for production builds.
VITE_WELLNESS_API_BASE_URL=
VITE_WELLNESS_WAITLIST_ENABLED=false
VITE_WELLNESS_AUTH_ENABLED=false
VITE_WELLNESS_PAYMENTS_ENABLED=false
VITE_WELLNESS_CLERK_PUBLISHABLE_KEY=
